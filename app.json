{
  "expo": {
    "name": "Super Awoof",
    "slug": "superawoof",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/favicon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "",
      "resizeMode": "contain",
      "backgroundColor": "#0F1219"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.steph4n.superawoof"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "",
        "backgroundColor": "#0F1219"
      },
      "package": "com.steph4n.superawoof"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "15bcbe17-956e-48b0-b359-9dfec98dd29b"
      }
    }
  }
}
